# Copy this file to .env and fill in real values before running docker-compose.
# .env is git-ignored - never commit real secrets.

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# --- Alpha Vantage (free tier, no credit card: https://www.alphavantage.co/support/#api-key) ---
ALPHAVANTAGE_API_KEY=demo

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
